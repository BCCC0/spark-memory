# The per-checkout mem client dir (config.toml + credentials). `credentials` and
# `.mem.toml` are ignored individually below; this keeps the whole directory out
# so a client config can never be committed by accident.
.mem-client/
.mem.toml
credentials
*.secret
*.token
*.log
deploy_manifest
deployment/
issue/
# Local working notes for planned work; not part of the published tree.
todos/
# Local Git hooks, installed with: git config core.hooksPath .githooks
.githooks/
tools/mcp_auth_probe/
